# Скопіюй у .env і заповни. Файл .env у .gitignore — у репозиторій не потрапить.

# Instagram Graph API
# IG_USER_ID вже відомий: акаунт @lisovik_com_ua, перевірено запитом
IG_USER_ID=17841437107880130

# Токен System User зі скоупами instagram_basic + instagram_content_publish.
# Наявний токен з ads-cockpit НЕ підходить: у нього тільки ads_management,
# ads_read, public_profile — публікація відповідає «(#10) Application does not
# have permission».
IG_ACCESS_TOKEN=

# Google Cloud Storage — Meta завантажує медіа сама, тому потрібне публічне
# посилання. Бакет уже створено і перевірено.
LISOVIK_BUCKET=lisovik-ig-media

# Telegram-бот для ревʼю (@BotFather -> токен, @userinfobot -> chat_id)
TG_BOT_TOKEN=
TG_CHAT_ID=
